# nginx do HOST (fora do Docker) — proxy reverso para o container web.
# Copie para /etc/nginx/sites-available/capivaratech.dgdlabs.com.br,
# ative com symlink em sites-enabled e rode:
#   sudo certbot --nginx -d capivaratech.dgdlabs.com.br
# (o certbot adiciona o bloco 443/SSL automaticamente)

server {
    listen 80;
    listen [::]:80;
    server_name capivaratech.dgdlabs.com.br;

    client_max_body_size 25M;

    location / {
        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}

# Os arquivos estáticos são servidos pelo próprio Django (WhiteNoise),
# então não é preciso um location /static/ aqui.
