# Copie para .env na pasta do projeto na VPS (~/capivara-tech/.env) e preencha.
# NÃO comitar o .env real.

# ---- Django ----
DEBUG=False
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=capivaratech.dgdlabs.com.br,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://capivaratech.dgdlabs.com.br

# ---- Postgres (container "db") ----
# POSTGRES_* são usados pelo container db e pelo pg_dump do deploy.sh.
# DATABASE_URL é o que o Django lê (host = "db", nome do serviço no compose).
POSTGRES_DB=capivara
POSTGRES_USER=capivara
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://capivara:troque-esta-senha@db:5432/capivara

# ---- E-mail SMTP (opcional; necessário p/ enviar e-mails de contato/inscrição) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Capivara Tech <contato@capivaratech.com.br>

# ---- S3 / mídia (opcional; só p/ Galeria e uploads de imagem no admin) ----
# Sem isso o site funciona normalmente; apenas upload de imagens falha.
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ACCESS_KEY_ID=
# AWS_S3_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_S3_URL_PROTOCOL=https:
