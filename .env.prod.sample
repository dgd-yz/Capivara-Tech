# Copie para .env na pasta do projeto na VPS (~/capivara-tech/.env) e preencha.
# NÃO comitar o .env real.

# ---- Django ----
DEBUG=False
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=capivaratech.dgdlabs.com.br,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://capivaratech.dgdlabs.com.br

# ---- Postgres (container "db") ----
# POSTGRES_* são usados pelo container db e pelo pg_dump do deploy.sh.
# DATABASE_URL é o que o Django lê (host = "db", nome do serviço no compose).
POSTGRES_DB=capivara
POSTGRES_USER=capivara
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://capivara:troque-esta-senha@db:5432/capivara

# ---- E-mail ----
# Padrão (sem nada abaixo): backend "console" — não envia nada, só imprime no log.
# Para ENVIAR de verdade, escolha UMA opção gratuita e simples e descomente:
#
# Opção A — Gmail (grátis; crie uma "Senha de app" em myaccount.google.com/apppasswords):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seuemail@gmail.com
# EMAIL_HOST_PASSWORD=sua-senha-de-app-de-16-digitos
# DEFAULT_FROM_EMAIL=Capivara Tech <seuemail@gmail.com>
#
# Opção B — Brevo (grátis 300 e-mails/dia; SMTP em app.brevo.com > SMTP & API):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu-login-brevo
# EMAIL_HOST_PASSWORD=sua-chave-smtp-brevo
# DEFAULT_FROM_EMAIL=Capivara Tech <contato@capivaratech.com.br>

# ---- Mídia ----
# As imagens (galeria/uploads) são salvas localmente na pasta uploads/
# (volume "capivara_uploads" no docker-compose.prod.yml). Não precisa de S3.
